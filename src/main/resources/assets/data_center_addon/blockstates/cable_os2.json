      },
      "apply": {
        "model": "data_center_addon:block/cable_os2_arm_south"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "data_center_addon:block/cable_os2_arm_east"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "data_center_addon:block/cable_os2_arm_west"
      }
    }
  ]
}
